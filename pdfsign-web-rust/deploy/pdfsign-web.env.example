# Copy to /etc/pdfsign/pdfsign-web.env and chmod 600

DATABASE_URL=postgres://pdfsign:CHANGE_ME@127.0.0.1:5432/pdfsign
PUBLIC_BASE_URL=https://pdfsign.example.com
# Alias still accepted: APP_URL=

# Required (≥32 chars). Never ship without this.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32
# Alias: HMAC_SECRET=

STORAGE_DIR=/opt/pdfsign/storage
DOWNLOADS_DIR=/opt/pdfsign/downloads
WEB_DIST=/opt/pdfsign/web/dist
COOKIE_SECURE=1
# Comma-separated browser origins (omit to use PUBLIC_BASE_URL + localhost)
# CORS_ORIGINS=https://pdfsign.thietkeweb.dev
ADMIN_TOKEN=change-me-admin-token
FILE_RETENTION_HOURS=48
REGISTERED_TRIAL_FILES=5
LISTEN=127.0.0.1:8080
RUST_LOG=info
