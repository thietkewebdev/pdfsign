{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFSign",
  "mainBinaryName": "PDFSign",
  "version": "0.2.0",
  "identifier": "vn.pdfsign.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDFSign",
        "width": 1320,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "PDFSign",
    "shortDescription": "Ký số PDF bằng USB token (PAdES)",
    "longDescription": "Ký số PDF offline bằng USB token PKCS#11: ký hàng loạt, nhiều chữ ký, mẫu chữ ký, dấu thời gian, LTV, xác minh.",
    "category": "Productivity",
    "copyright": "PDFSign",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
