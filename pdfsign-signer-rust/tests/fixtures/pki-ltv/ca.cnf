[ca]
default_ca = test_ca
[test_ca]
dir = .
database = ./index.txt
new_certs_dir = ./newcerts
serial = ./serial
crlnumber = ./crlnumber
certificate = ./ca.cert.pem
private_key = ./ca.key.pem
default_md = sha256
default_days = 3650
default_crl_days = 30
policy = any
copy_extensions = none
unique_subject = no
[any]
countryName = optional
localityName = optional
organizationName = optional
commonName = supplied
[req]
distinguished_name = dn
prompt = no
utf8 = yes
string_mask = utf8only
[dn]
C = VN
O = PDFSign LTV Test CA (KHONG TIN CAY)
CN = PDFSign LTV Test Root CA
[v3_ca]
basicConstraints = critical, CA:true
keyUsage = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash
[aia]
authorityInfoAccess = caIssuers;URI:http://127.0.0.1:18080/ca.cert.der, OCSP;URI:http://127.0.0.1:18081
crlDistributionPoints = URI:http://127.0.0.1:18080/ca.crl
[v3_signer]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature, nonRepudiation
extendedKeyUsage = clientAuth, emailProtection
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
authorityInfoAccess = caIssuers;URI:http://127.0.0.1:18080/ca.cert.der, OCSP;URI:http://127.0.0.1:18081
crlDistributionPoints = URI:http://127.0.0.1:18080/ca.crl
[v3_tsa]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature, nonRepudiation
extendedKeyUsage = critical, timeStamping
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
authorityInfoAccess = caIssuers;URI:http://127.0.0.1:18080/ca.cert.der, OCSP;URI:http://127.0.0.1:18081
crlDistributionPoints = URI:http://127.0.0.1:18080/ca.crl
[v3_ocsp]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, OCSPSigning
noCheck = ignored
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
